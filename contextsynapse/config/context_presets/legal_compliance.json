{
  "name": "GDPR Compliance Updates",
  "description": "GDPR and data protection regulatory updates",
  "context_type": "knowledge_base",
  "sensitivity": "internal",
  "tags": ["legal", "compliance"],
  "pipeline": {
    "template_id": "builtin:schema-guided",
    "source_url": "https://gdpr-info.eu/",
    "max_pages": 5,
    "schema_id": "legal_document",
    "schema_mode": "strict"
  },
  "filters": {
    "keyword_exclude": ["advertisement", "sponsored"],
    "keyword_include": ["GDPR", "data protection", "privacy", "compliance", "regulation", "fine", "penalty"],
    "semantic_rules": [],
    "semantic_mode": "or"
  },
  "schedule": {"trigger_type": "scheduled", "interval_minutes": 1440}
}
