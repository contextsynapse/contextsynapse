{
  "name": "TOI Politics & Economy",
  "description": "Indian political and economic news from Times of India",
  "context_type": "knowledge_base",
  "sensitivity": "public",
  "tags": ["news", "india", "politics"],
  "pipeline": {
    "template_id": "builtin:smart-article",
    "source_url": "https://timesofindia.indiatimes.com/",
    "max_pages": 5,
    "schema_id": "news_article",
    "schema_mode": "schema_plus"
  },
  "filters": {
    "keyword_exclude": ["cricket", "bollywood", "horoscope", "recipe"],
    "keyword_include": ["politics", "economy", "policy", "parliament", "budget", "RBI"],
    "semantic_rules": [
      {"description": "Indian government policy decisions and legislation", "threshold": 0.7},
      {"description": "Economic reforms, GDP, inflation, and RBI monetary policy", "threshold": 0.6},
      {"description": "Elections, political parties, and campaign news", "threshold": 0.65}
    ],
    "semantic_mode": "or"
  },
  "schedule": {"trigger_type": "scheduled", "interval_minutes": 60}
}
