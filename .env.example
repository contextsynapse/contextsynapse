# ═══════════════════════════════════════════════════════════════════
# ContextSynapse Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# All settings have sensible defaults — only set what you need.

# ── Core ──────────────────────────────────────────────────────────
CONTEXTSYNAPSE_ENV=development            # development | production
CONTEXTSYNAPSE_ADMIN_KEY=your-secure-admin-key-here
CONTEXTSYNAPSE_JWT_SECRET=your-jwt-secret-here

# ── API Server ────────────────────────────────────────────────────
# CONTEXTSYNAPSE_API_HOST=0.0.0.0
# CONTEXTSYNAPSE_API_PORT=8000
# CONTEXTSYNAPSE_API_WORKERS=1
CONTEXTSYNAPSE_CORS_ORIGINS=http://localhost:3000
CONTEXTSYNAPSE_RATE_LIMIT_RPM=300
CONTEXTSYNAPSE_QUERY_TIMEOUT=30

# ── Graph Backend ─────────────────────────────────────────────────
# Default: csr (in-memory, fastest, no setup needed)
# Options: csr | redis | lmdb
# CONTEXTSYNAPSE_GRAPH_BACKEND=csr

# Redis backend (for multi-worker, shared state)
# CONTEXTSYNAPSE_REDIS_URL=redis://localhost:6379

# LMDB backend (for single-node persistence)
# CONTEXTSYNAPSE_STORAGE_BACKEND=lmdb
# CONTEXTSYNAPSE_LMDB_PATH=contextcore_data/lmdb

# ── Database (users, tenants, auth) ──────────────────────────────
# Default: SQLite (contextcore_data/context.db)
# For production: PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/contextsynapse

# ── LLM Providers ────────────────────────────────────────────────
# Not required for core graph operations.
# Needed for: entity extraction, RAG answers, natural language queries,
#             agent playground, and context assembly intelligence.
#
# Set ANY one of these — ContextSynapse auto-detects the provider:
# GROQ_API_KEY=gsk_your-key-here           # Fastest, free tier available
# OPENAI_API_KEY=sk-your-key-here          # Most reliable
# ANTHROPIC_API_KEY=sk-ant-your-key-here   # Best reasoning
# DEEPSEEK_API_KEY=your-key-here           # Cost-effective
# TOGETHER_API_KEY=your-key-here           # Open-source models
# MISTRAL_API_KEY=your-key-here            # EU-hosted
# CEREBRAS_API_KEY=your-key-here           # Fast inference
# FIREWORKS_API_KEY=your-key-here          # Serverless
# PERPLEXITY_API_KEY=your-key-here         # Search-augmented
# GOOGLE_API_KEY=your-key-here             # Gemini (multimodal)
# COHERE_API_KEY=your-key-here             # RAG-optimized

# Ollama (local, no API key needed)
OLLAMA_HOST=http://localhost:11434

# LLM rate limiting
# CONTEXTSYNAPSE_LLM_CONCURRENCY=10        # Max concurrent LLM calls
# CONTEXTSYNAPSE_LLM_RPM=100               # Max LLM requests per minute

# ── Embedding Models ─────────────────────────────────────────────
# Default: Ollama nomic-embed-text (768 dims, local, free)
# Fallback: NumPy cosine similarity (no model needed)
#
# Supported embedding providers:
#   Ollama:    nomic-embed-text (768d), mxbai-embed-large (1024d), all-minilm (384d)
#   OpenAI:    text-embedding-3-small (1536d), text-embedding-3-large (3072d)
#   Cohere:    embed-english-v2.0 (4096d)
#   Gemini:    text-embedding-004 (768d)
#   Mistral:   mistral-embed (1024d)
#   Together:  m2-bert-80M-8k-retrieval (768d)
#
# To use a specific model, set in config/config.yaml:
#   embeddings:
#     provider: "local"          # "local" (sentence-transformers) or "ollama"
#     model: "all-MiniLM-L6-v2"  # model name
#     dimension: 384             # must match model output

# ── Vector Database ──────────────────────────────────────────────
# Default: built-in NumPy cosine store (no setup needed)
# Options: custom (numpy) | qdrant | faiss | chroma
# CONTEXTSYNAPSE_VECTOR_DB_BACKEND=custom

# Qdrant (production vector search)
# QDRANT_URL=http://localhost:6333

# ChromaDB (embedded vector search)
# — uses chromadb Python package, no server needed

# ── Search ────────────────────────────────────────────────────────
# Full-text search: LMDB index (default) or Whoosh (fallback)
# No configuration needed — auto-selects best available backend.

# ── Security ──────────────────────────────────────────────────────
# PII detection: built-in regex patterns (no config needed)
# Field encryption: uses cryptography package (Fernet AES), falls back to Base64
# RBAC: built-in role matrix
# Audit trail: SQLite WAL mode (contextcore_data/audit_trail.db)

# ── Cloud Storage (optional) ────────────────────────────────────
# Set CONTEXTSYNAPSE_STORAGE_BACKEND to: s3 | gcs | azure | local (default)

# Amazon S3 / MinIO / Cloudflare R2
# CONTEXTSYNAPSE_STORAGE_BACKEND=s3
# CONTEXTSYNAPSE_S3_BUCKET=my-bucket
# CONTEXTSYNAPSE_S3_PREFIX=graphs/
# CONTEXTSYNAPSE_S3_REGION=us-east-1
# CONTEXTSYNAPSE_S3_ENDPOINT=                # For S3-compatible (MinIO, R2)

# Google Cloud Storage
# CONTEXTSYNAPSE_STORAGE_BACKEND=gcs
# CONTEXTSYNAPSE_GCS_BUCKET=my-bucket
# CONTEXTSYNAPSE_GCS_PREFIX=graphs/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Azure Blob Storage
# CONTEXTSYNAPSE_STORAGE_BACKEND=azure
# CONTEXTSYNAPSE_AZURE_CONTAINER=my-container
# CONTEXTSYNAPSE_AZURE_PREFIX=graphs/
# CONTEXTSYNAPSE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# CONTEXTSYNAPSE_AZURE_ACCOUNT_URL=https://myaccount.blob.core.windows.net  # (uses DefaultAzureCredential)

# ── Advanced ──────────────────────────────────────────────────────
# CONTEXTSYNAPSE_MAX_GRAPHS=50              # Max graphs in memory (LRU eviction)
# CONTEXTSYNAPSE_CONFIDENCE_HALFLIFE_DAYS=28 # Memory confidence decay half-life
# CONTEXTSYNAPSE_PRUNE_INTERVAL=3600        # Auto-prune interval (seconds)
# CONTEXTSYNAPSE_WB_FLUSH_INTERVAL=10       # Write-behind flush interval
# CONTEXTSYNAPSE_REGION=local               # Deployment region tag
# CONTEXTSYNAPSE_ENABLE_TINKER=0            # Enable tinker mode (dev only)
# CONTEXTSYNAPSE_STORAGE_DIR=contextcore_data  # Data directory

# ── MCP Server ────────────────────────────────────────────────────
# CONTEXTSYNAPSE_NAMESPACE=default          # Default graph namespace
# CONTEXTSYNAPSE_AGENT_NAME=unknown         # Agent identity for MCP
# CONTEXTSYNAPSE_API_KEY=                   # API key for authenticated MCP
# CONTEXTSYNAPSE_SESSION_ID=                # Session to connect to
# CONTEXTSYNAPSE_MCP_MAX_SESSIONS=50        # Max concurrent MCP sessions
