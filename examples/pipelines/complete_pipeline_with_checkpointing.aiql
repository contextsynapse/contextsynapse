-- ============================================================================
-- COMPLETE PIPELINE WITH CHECKPOINTING AND HIERARCHICAL CHUNKING
-- ============================================================================
-- A comprehensive pipeline for ingesting documents with:
-- - Hierarchical chunking (preserves document structure)
-- - Checkpointing support (can restart from any stage)
-- - Complete extraction, chunking, embedding, and indexing
-- - AIQL search enabled
--
-- Usage:
--   1. CREATE NAMESPACE my_docs;
--   2. USE NAMESPACE my_docs;
--   3. CREATE PIPELINE complete_pipeline ... (this pipeline)
--   4. RUN PIPELINE complete_pipeline WITH file_path="path/to/document.pdf";
-- ============================================================================

CREATE PIPELINE complete_pipeline
IN NAMESPACE default
SOURCE COLLECTION raw_documents
TARGET COLLECTION processed_documents
DESCRIPTION "Complete pipeline with hierarchical chunking and checkpointing support"
CHECKPOINT POLICY enabled
STAGES = [
-- ============================================================================
-- STAGE 1: EXTRACT
-- ============================================================================
-- Extracts content from documents (PDF, DOCX, TXT, etc.)
-- Detects text, tables, and images
-- Creates normalized JSON structure
-- ============================================================================
STEP extract
    EXTRACT FROM FILE "{file_path}"
    USING READER "AUTO"
    DETECT (TEXT, TABLES, IMAGES)
    PARSE_METADATA TRUE
    STORE AS NODE TYPES (Document, Table, Image)
    LINK (Document TO Table, Document TO Image)
    STORE INTERMEDIATE IN COLLECTION raw_documents
    OUTPUT_DIR "ainatdb_data"
    STORE_NORMALIZED TRUE,

-- ============================================================================
-- STAGE 2: CONNECT
-- ============================================================================
-- Creates graph nodes from normalized JSON
-- Links Document, Table, and Image nodes
-- ============================================================================
STEP connect
    CONNECT FROM NORMALIZED
    CREATE NODES (Document, Table, Image)
    LINK (Document TO Table, Document TO Image)
    STORE INTERMEDIATE IN COLLECTION raw_documents,

-- ============================================================================
-- STAGE 3: CHUNK (HIERARCHICAL)
-- ============================================================================
-- Hierarchical chunking that preserves document structure:
-- - Document (root)
-- - Page
-- - Section/Heading (if available)
-- - Paragraph/Block
-- - Chunk (leaf)
-- Creates Chunk nodes with hierarchical relationships
-- ============================================================================
STEP chunk
    CHUNK BY fixed
    PARAMETERS (
        chunk_size=1000,
        overlap=200
    )
    STORE AS NODE TYPE Chunk
    LINK TO Document ON HAS_CHUNK
    STORE INTERMEDIATE IN COLLECTION processed_documents,

-- ============================================================================
-- STAGE 4: EMBED
-- ============================================================================
-- Generates vector embeddings for chunks
-- Enables semantic search and similarity matching
-- Stores embeddings in Chunk nodes
-- ============================================================================
STEP embed
    EMBED USING PROFILE embedv1
    PARAMETERS (
        model="text-embedding-3-large",
        dimensions=3072
    )
    STORE EMBEDDING IN Chunk.embedding
    STORE INTERMEDIATE IN COLLECTION processed_documents,

-- ============================================================================
-- STAGE 5: EXTRACT ENTITIES
-- ============================================================================
-- Extracts named entities from chunks (People, Organizations, Locations, etc.)
-- Creates Entity nodes linked to Chunks
-- Enables entity-based search and queries
-- ============================================================================
STEP extract_entities
    EXTRACT ENTITIES
    USING LLM "gpt-4"
    PROMPT "Extract all named entities from the text. Identify and categorize entities such as: Organizations, People, Locations, Products, Dates, Financial figures, Technologies, Concepts, and Events. For each entity, provide: name, type, description, and context."
    STORE AS NODE TYPE Entity
    LINK TO Chunk ON MENTIONS
    STORE INTERMEDIATE IN COLLECTION processed_documents

-- ============================================================================
-- STAGE 6: EXTRACT RELATIONSHIPS
-- ============================================================================
-- Extracts relationships between entities
-- Creates Relationship edges between entities
-- Enables graph traversal and relationship queries
-- ============================================================================
-- NOTE: EXTRACT RELATIONSHIPS temporarily disabled due to parser limitations
-- STEP extract_relationships
--     EXTRACT RELATIONSHIPS
--     USING LLM "gpt-4"
--     PROMPT "Identify relationships between entities. Extract relationships such as: works_for, located_in, owns, partners_with, competes_with, supplies, uses, develops, manages, reports_to, etc. For each relationship, provide: source entity, target entity, relationship type, strength/confidence, and context."
--     STORE AS EDGE TYPE Relationship
--     STORE INTERMEDIATE IN COLLECTION processed_documents

]

-- ============================================================================
-- PIPELINE METADATA
-- ============================================================================
-- This pipeline processes documents through the following stages:
-- 1. Extract: Reads and parses documents, creates normalized JSON
-- 2. Connect: Creates graph nodes from normalized data
-- 3. Chunk: Hierarchical chunking preserving document structure
-- 4. Embed: Generates vector embeddings for semantic search
-- 5. Extract Entities: Extracts named entities (People, Organizations, etc.)
-- 6. Extract Relationships: Extracts relationships between entities
--
-- Checkpointing:
-- - Checkpoints are created after each stage
-- - Can restart from any checkpoint using: RUN PIPELINE ... FROM CHECKPOINT <id>
-- - Checkpoint policy is enabled by default
--
-- Output:
-- - Document nodes (with full content)
-- - Chunk nodes (with embeddings and hierarchical relationships)
-- - Entity nodes (People, Organizations, Locations, etc.)
-- - Relationship edges (connecting entities)
-- - Table nodes (if tables detected)
-- - Image nodes (if images detected)
-- ============================================================================

